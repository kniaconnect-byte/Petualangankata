   showScreen('quizScreen');renderQuestion();
 }
 function renderQuestion(){
   const q=questions[quizIndex];
   $('quizScore').textContent=`✦ ${quizScore} poin`;
   $('quizCount').textContent=`${quizIndex+1} / ${questions.length}`;
   $('quizProgress').style.width=`${quizIndex/questions.length*100}%`;
   $('questionCategory').textContent=q.category;
   $('questionText').textContent=`What is “${q.word}”?`;
   $('questionPrompt').textContent=q.prompt;
   $('quizFeedback').textContent='Pilih lampion yang menurutmu tepat!';
   const field=$('lanternField');field.innerHTML='';
   shuffle(q.opts).forEach((option,i)=>{
     const b=document.createElement('button');b.type='button';b.className='answer-lantern';b.dataset.answer=option;
     b.setAttribute('aria-label',`Jawaban ${option}`);
     const rope=document.createElement('span');rope.className='rope';
     const body=document.createElement('span');body.className='lantern-body';body.textContent=option;
     b.append(rope,body);
     b.addEventListener('click',()=>answerQuestion(b,option,q));
     field.appendChild(b);
   });
   quizLocked=false;
 }
 function answerQuestion(button, option, q){
   if(quizLocked)return;quizLocked=true;
   const all=[...$('lanternField').querySelectorAll('button')];all.forEach(b=>b.disabled=true);
   const isCorrect=option===q.correct;
   if(isCorrect){
     quizScore+=10;quizCorrect++;button.classList.add('correct');
     $('quizFeedback').textContent=`Betul! “${q.word}” artinya ${q.meaning}. +10 poin!`;
     burstAt(button,'✦');
   }else{
     button.classList.add('wrong');
     const correctButton=all.find(b=>b.dataset.answer===q.correct);
     if(correctButton)correctButton.classList.add('correct');
     $('quizFeedback').textContent=`Hampir! “${q.word}” artinya ${q.meaning}. Yuk, simpan kata ini!`;
     burstAt(button,'♡');
   }
   $('quizScore').textContent=`✦ ${quizScore} poin`;
   $('quizProgress').style.width=`${(quizIndex+1)/questions.length*100}%`;
   window.setTimeout(()=>{
     quizIndex++;
     if(quizIndex>=questions.length)showResults('quiz');
     else renderQuestion();
   },1100);
 }
 function burstAt(el,glyph){
   const rect=el.getBoundingClientRect();
   for(let i=0;i<5;i++){
     const s=document.createElement('span');s.className='burst';s.textContent=glyph;
     s.style.left=(rect.left+rect.width/2+(Math.random()*70-35))+'px';
     s.style.top=(rect.top+rect.height/2+(Math.random()*35-20))+'px';
     s.style.position='fixed';document.body.appendChild(s);setTimeout(()=>s.remove(),750);
   }
   if(glyph==='✦')confetti();
 }
