}
@media(max-width:390px){
 .gate-desc{font-size:13px}
 .gate-title{font-size:17px}
 .game-head .text-link{padding:6px;font-size:13px}
 .pill{font-size:12px}
 .answer-lantern .lantern-body{font-size:14px}
}
/* ===== Hidden Object v2: dunia 2900px yang bisa digeser, 20 soal, Pipin berjalan ===== */
.hx-stage{position:relative;height:clamp(440px,calc(100dvh - 170px),780px);border-radius:28px;overflow:hidden;background:#d4ecdf;border:5px solid #f5e8d2;box-shadow:var(--soft-shadow);isolation:isolate;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
.hx-viewport{position:absolute;inset:0;overflow:hidden;cursor:grab;touch-action:none;overscroll-behavior:contain}
.hx-viewport.dragging{cursor:grabbing}
.hx-world{position:absolute;left:0;top:0;width:2900px;height:620px;transform-origin:0 0;will-change:transform}
.hx-art{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.hx-spot{position:absolute;z-index:2;border:0;padding:0;background:transparent;border-radius:50%;transform:translate(-50%,-50%);touch-action:none;transition:background .2s}
.hx-spot:hover{background:#ffffff26}
.hx-spot.near{outline:4px dashed #fff;outline-offset:-3px;background:#ffffff30;animation:hxNear 1s ease-in-out infinite}
.hx-spot.found{outline:4px solid #ffdb6b;background:#fff5a833;animation:none}
.hx-spot.found:after{content:"✓";position:absolute;right:-6px;top:-6px;width:28px;height:28px;border-radius:50%;background:#318d70;color:#fff;font:900 16px/28px var(--sans);text-align:center;border:2px solid #fff}
.hx-spot.wrong{animation:hxWobble .3s ease}
@keyframes hxNear{0%,100%{box-shadow:0 0 0 0 #ffffff80}50%{box-shadow:0 0 0 12px #ffffff00}}
@keyframes hxWobble{0%,100%{transform:translate(-50%,-50%)}35%{transform:translate(calc(-50% - 6px),-50%)}70%{transform:translate(calc(-50% + 6px),-50%)}}
.hx-tap{position:absolute;z-index:1;width:40px;height:40px;margin:-20px 0 0 -20px;border:4px solid #fff;border-radius:50%;pointer-events:none;animation:hxTap .7s ease-out forwards}
@keyframes hxTap{from{transform:scale(.3);opacity:1}to{transform:scale(1.5);opacity:0}}
.hx-pipin{position:absolute;left:0;top:0;width:60px;height:83px;z-index:5;pointer-events:none;will-change:transform}
.hx-dir{width:100%;height:100%;transition:transform .12s}
.hx-dir.flip{transform:scaleX(-1)}
.hx-dir svg{width:100%;height:100%;overflow:visible}
.hx-pipin .leg{transform-box:view-box}
.hx-pipin .leg.l{transform-origin:45px 143px}
.hx-pipin .leg.r{transform-origin:83px 143px}
.hx-pipin .bod{transform-box:view-box;transform-origin:65px 160px}
.hx-pipin.walking .bod{animation:hxBob .34s ease-in-out infinite}
.hx-pipin.walking .leg.l{animation:hxLeg .34s ease-in-out infinite alternate}
.hx-pipin.walking .leg.r{animation:hxLeg .34s ease-in-out infinite alternate-reverse}
.hx-pipin.act .hx-dir{animation:hxHop .4s ease}
@keyframes hxBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
@keyframes hxLeg{from{transform:rotate(-26deg)}to{transform:rotate(26deg)}}
@keyframes hxHop{0%,100%{transform:translateY(0)}40%{transform:translateY(-16px)}}
