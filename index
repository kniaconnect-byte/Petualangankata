<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#f8dbe4">
<title>KniaWorld — Petualangan Kata Rahasia</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,500,30,1;9..144,600,30,1;9..144,700,30,1&family=Mulish:wght@500;600;700;800;900&display=swap" rel="stylesheet">
<style>
/* VISUAL DNA
   Konsep: jurnal petualangan bahasa yang terbuka ke taman kata rahasia.
   Warna: pink kelopak untuk gerbang/aksen, mint untuk area aman dan jawaban benar,
   coral untuk koreksi lembut, cream kertas sebagai dasar yang hangat.
   Tipografi: Fraunces memberi rasa buku cerita; Mulish menjaga instruksi mudah dibaca.
   Bentuk: siluet organik, jendela taman, lampion dan objek yang hidup di dalam scene.
   Ilustrasi: SVG inline berlapis dengan wash watercolor CSS, garis lembut dan tekstur kertas.
   Maskot: Pipin, pensil mungil berwajah jahil dengan syal mint; melambai dengan goyangan kecil.
   Kedalaman/animasi: dedaunan depan, bukit tengah, langit belakang; gerak cepat tapi hemat.
*/
:root{
 --paper:#fff8ed;--paper-deep:#f6e9d7;--ink:#3e4b46;--muted:#64736b;
 --pink:#ed91b0;--pink-deep:#c9507c;--pink-pale:#f9dce6;
 --mint:#8ed8bf;--mint-deep:#318d70;--mint-pale:#d9f2e7;
 --coral:#df746e;--gold:#f2c66d;--sky:#b9e2e8;--leaf:#7daf85;
 --shadow:0 12px 26px rgba(85,83,61,.12);--soft-shadow:0 5px 12px rgba(85,83,61,.10);
 --serif:'Fraunces',Georgia,serif;--sans:'Mulish',system-ui,sans-serif;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{margin:0;min-height:100%;background:var(--paper);color:var(--ink);font-family:var(--sans)}
body{min-height:100dvh;overflow-x:hidden}
button{font:inherit;color:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}
button:focus-visible,[role="button"]:focus-visible{outline:3px solid var(--mint-deep);outline-offset:4px}
button:disabled{cursor:default}
.app{min-height:100dvh;position:relative;isolation:isolate;overflow:hidden;background:
 radial-gradient(ellipse at 10% 12%,rgba(237,145,176,.19),transparent 34%),
 radial-gradient(ellipse at 88% 72%,rgba(142,216,191,.24),transparent 35%),var(--paper)}
.paper-grain{position:fixed;inset:0;pointer-events:none;z-index:8;opacity:.17;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.15'/%3E%3C/svg%3E")}
.screen{min-height:100dvh;position:relative;padding:clamp(14px,3vw,30px);animation:arrive .45s ease both}
@keyframes arrive{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}
.brand{font:700 20px var(--serif);letter-spacing:-.5px;color:var(--pink-deep)}
.brand span{color:var(--mint-deep)}
.eyebrow{font-size:14px;letter-spacing:1.4px;text-transform:uppercase;font-weight:900;color:var(--mint-deep)}
h1,h2,h3,p{margin-top:0}
h1,h2,h3{font-family:var(--serif);font-weight:700;letter-spacing:-.8px}
p{line-height:1.55}
.small-note{font-size:14px;color:var(--muted)}
.primary-cta{border:0;border-radius:100px;padding:15px 25px;min-height:54px;background:var(--pink-deep);color:white;font-weight:900;box-shadow:0 5px 0 #a83e66,0 9px 18px #d989a34d;transition:transform .15s,box-shadow .15s}
.primary-cta:hover{transform:translateY(-2px);box-shadow:0 7px 0 #a83e66,0 12px 20px #d989a34d}
.primary-cta:active{transform:translateY(3px);box-shadow:0 2px 0 #a83e66}
.soft-cta{border:2px solid #9bd9c2;background:#f5fff9;color:var(--mint-deep);border-radius:100px;padding:12px 18px;min-height:48px;font-weight:900}
.text-link{background:transparent;border:0;text-decoration:underline;text-decoration-color:#d88aa4;text-underline-offset:4px;font-weight:900;padding:12px;min-height:48px}
.scene-art{position:absolute;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none}
.welcome{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.8fr);align-items:center;gap:2vw;max-width:1180px;margin:auto;min-height:calc(100dvh - 60px)}
.welcome-copy{position:relative;z-index:2;padding:clamp(10px,4vw,48px) 0}
.welcome h1{font-size:clamp(44px,7.2vw,88px);line-height:.96;margin:14px 0 22px;max-width:650px}
.welcome h1 .line2{display:block;color:var(--pink-deep);font-size:.76em}
.welcome .tagline{font-size:clamp(18px,2vw,21px);max-width:480px;margin-bottom:26px}
.welcome-visual{position:relative;min-height:390px;display:grid;place-items:center}
.gate-art{width:min(100%,480px);height:auto;filter:drop-shadow(0 16px 18px #8c796522)}
.mascot{transform-origin:bottom center;animation:mascotWiggle 2.7s ease-in-out infinite}
@keyframes mascotWiggle{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
.welcome-visual .mascot-big{position:absolute;width:118px;left:50%;top:39%;transform:translateX(-50%);animation:wave 1.2s ease-in-out 2}
@keyframes wave{0%,100%{transform:translateX(-50%) translateY(0)}35%{transform:translateX(-50%) translateY(-7px)}70%{transform:translateX(-50%) translateY(1px)}}
.cta-wrap{display:flex;gap:14px;align-items:center;flex-wrap:wrap}
.cta-wrap .primary-cta{animation:gentlePulse 2.8s ease-in-out 1.5s infinite}
@keyframes gentlePulse{0%,100%{box-shadow:0 5px 0 #a83e66,0 9px 18px #d989a34d}50%{box-shadow:0 5px 0 #a83e66,0 9px 25px #d989a388}}
.welcome-footer{position:absolute;bottom:18px;left:clamp(14px,3vw,30px);font-size:13px;color:#7a887f}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:14px;max-width:1120px;margin:0 auto 12px}
.topbar .text-link{font-size:15px}
.menu-screen{max-width:1120px;margin:auto;min-height:calc(100dvh - 60px);display:flex;flex-direction:column;justify-content:center}
.menu-heading{max-width:650px;margin:20px 0 30px}
.menu-heading h2{font-size:clamp(36px,5vw,58px);margin:8px 0}
.gates{display:flex;align-items:flex-start;justify-content:center;gap:clamp(12px,4vw,50px);min-height:330px}
.game-gate{position:relative;border:0;background:transparent;padding:0 10px 14px;min-width:0;display:flex;flex-direction:column;align-items:center;text-align:center;transition:transform .2s;max-width:340px}
.game-gate:hover{transform:translateY(-5px)}
.gate-shape{width:clamp(142px,25vw,250px);height:clamp(190px,31vw,290px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;position:relative;padding:20px 14px 24px;filter:drop-shadow(0 10px 10px #6b8b7b25)}
.gate-shape.quiz{background:#f4c0d1;border-radius:48% 48% 9px 9px / 28% 28% 9px 9px;outline:5px solid #f4c0d1;outline-offset:-8px}
.gate-shape.hidden-game{background:#b9e8d5;border-radius:38% 38% 45% 45% / 16% 16% 8% 8%;outline:5px solid #b9e8d5;outline-offset:-8px}
.gate-shape:before{content:"";position:absolute;inset:15px;border:2px dashed #fff9e9;border-radius:inherit;pointer-events:none}
.gate-illustration{width:74px;height:74px;z-index:1}
.gate-title{font:700 clamp(19px,2.2vw,25px) var(--serif);z-index:1;line-height:1.1}
.gate-desc{font-size:15px;max-width:220px;line-height:1.35;z-index:1}
.pick-label{margin-top:10px;font-weight:900;color:var(--pink-deep);font-size:16px;border-bottom:3px solid #efabc2;padding:5px 12px}
.game-gate:nth-child(2){margin-top:54px}
.game-shell{max-width:1180px;margin:auto;min-height:calc(100dvh - 44px);display:flex;flex-direction:column}
.game-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:8px}
.game-head .left,.game-head .right{display:flex;align-items:center;gap:10px}
.pill{background:#fff3f7;border:1px solid #f0bdd0;padding:8px 13px;border-radius:99px;font-weight:900;font-size:15px;white-space:nowrap}
.progress-wrap{display:flex;align-items:center;gap:12px;margin:5px 0 15px}
.progress-track{height:10px;background:#eadfd2;border-radius:20px;flex:1;overflow:hidden}
.progress-fill{height:100%;width:0;background:linear-gradient(90deg,var(--pink),var(--mint));border-radius:20px;transition:width .35s}
.quiz-scene{position:relative;flex:1;min-height:520px;border-radius:45% 45% 20px 20px / 10% 10% 20px 20px;overflow:hidden;background:#d8f0e4;border-bottom:8px solid #91c7a0;padding:clamp(18px,4vw,42px) clamp(12px,3vw,30px) 24px}
.quiz-scene:before{content:"";position:absolute;left:-5%;right:-5%;bottom:0;height:36%;background:#acd7a8;border-radius:48% 48% 0 0 / 25% 25% 0 0}
.quiz-scene:after{content:"";position:absolute;left:0;right:0;bottom:0;height:18%;background:#83b98d;clip-path:ellipse(65% 48% at 50% 100%)}
.quiz-question{position:relative;z-index:2;width:min(680px,94%);margin:0 auto;text-align:center;padding:16px 20px 18px;background:#fff8e9;border-radius:48% 48% 20px 20px / 22% 22% 12px 12px;box-shadow:var(--soft-shadow);border-bottom:4px solid #e7cba5}
.quiz-question .question-label{font-size:14px;color:var(--mint-deep);font-weight:900;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px}
.quiz-question h2{font-size:clamp(26px,4vw,40px);line-height:1.1;margin:0 0 8px}
.quiz-question p{font-size:18px;margin:0}
.lantern-field{position:relative;z-index:2;display:flex;justify-content:space-around;align-items:flex-start;gap:8px;max-width:900px;margin:0 auto;height:270px}
.answer-lantern{position:relative;border:0;background:transparent;padding:0 6px 12px;min-width:0;width:22%;display:flex;align-items:center;flex-direction:column;--drop:0px;transition:filter .2s}
.answer-lantern:nth-child(1){--drop:5px}.answer-lantern:nth-child(2){--drop:39px}.answer-lantern:nth-child(3){--drop:18px}.answer-lantern:nth-child(4){--drop:55px}
.rope{height:var(--drop);min-height:10px;width:2px;background:#aa9c7c;display:block;transition:height .2s}
.lantern-body{width:clamp(78px,13vw,132px);height:clamp(105px,16vw,145px);position:relative;display:grid;place-items:center;padding:12px 8px;color:#3e4b46;font-size:clamp(16px,2vw,20px);font-weight:900;line-height:1.12;background:#f8bfd2;border-radius:48% 48% 43% 43% / 32% 32% 42% 42%;box-shadow:inset 0 0 0 3px #fff3d9, inset 0 -10px 0 #d87e9d55,0 7px 0 #b85e8055;transition:transform .2s,background .2s;overflow-wrap:anywhere}
.answer-lantern:nth-child(2) .lantern-body{background:#a8e6d0;border-radius:43% 43% 49% 49% / 35% 35% 38% 38%}
.answer-lantern:nth-child(3) .lantern-body{background:#f5d28b;border-radius:46% 46% 38% 38% / 28% 28% 46% 46%}
.answer-lantern:nth-child(4) .lantern-body{background:#c6e4e7;border-radius:42% 42% 46% 46% / 35% 35% 35% 35%}
.lantern-body:before{content:"";position:absolute;top:8px;left:22%;width:22%;height:34%;border-radius:50%;background:#fff9;filter:blur(2px)}
.answer-lantern:hover:not(:disabled) .lantern-body{transform:translateY(-4px);filter:saturate(1.08)}
.answer-lantern:focus-visible{outline:3px solid var(--mint-deep);outline-offset:3px;border-radius:50px}
.answer-lantern.correct .lantern-body{background:#79d4a7!important;box-shadow:0 0 0 5px #fff6c6,0 0 25px #73d6a8}
.answer-lantern.wrong .lantern-body{background:#ef9a91!important;box-shadow:0 0 0 5px #fff1df}
.answer-lantern.correct .lantern-body:after{content:"✓";position:absolute;top:-12px;right:-7px;background:#fff8df;border-radius:50%;width:34px;height:34px;display:grid;place-items:center;color:#25845e;font-size:23px}
.answer-lantern.wrong .lantern-body:after{content:"Coba lagi";position:absolute;bottom:3px;left:0;right:0;font-size:12px;color:#873c3b}
.answer-lantern:disabled{opacity:1}
.quiz-feedback{position:relative;z-index:3;text-align:center;min-height:44px;margin:4px auto 0;font-size:19px;font-weight:900;color:#315f50}
.mascot-mini{width:56px;height:75px;flex:none}
.game-bottom{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:10px}
.game-bottom .hint{font-size:14px;color:var(--muted);margin:0}
.mini-button{border:1px solid #d8cbb8;background:#fff9ef;border-radius:99px;padding:10px 14px;min-height:48px;font-weight:900}
.hidden-status{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.result-screen{max-width:1050px;margin:auto;min-height:calc(100dvh - 50px);display:grid;grid-template-columns:minmax(230px,.8fr) minmax(0,1.2fr);align-items:center;gap:clamp(20px,5vw,70px)}
.result-art{position:relative;min-height:360px;display:grid;place-items:center}
.scoreboard{width:min(100%,330px);padding:28px 20px 24px;background:#365e50;color:#fff6d8;border-radius:22px 22px 35px 35px;text-align:center;box-shadow:0 12px 0 #25483c,0 18px 28px #3554482b;position:relative;border:5px solid #e4c58a}
.scoreboard:before{content:"PETUALANG KATA";font-size:13px;letter-spacing:2px;color:#d2f1d9;font-weight:900}
.score-value{font:700 clamp(54px,8vw,80px) var(--serif);line-height:1.1;color:#ffe49b;margin:10px 0}
.score-label{font-weight:800;font-size:15px;color:#d9f2e7}
.stars{display:flex;justify-content:center;gap:9px;margin:18px 0}
.star{font-size:42px;color:#7e9584;opacity:.45;display:inline-block}
.star.lit{color:#ffd76e;opacity:1;animation:starOn .5s cubic-bezier(.2,1.5,.5,1) both;filter:drop-shadow(0 0 8px #ffd76e88)}
@keyframes starOn{from{transform:scale(.3);opacity:.1}to{transform:scale(1);opacity:1}}
.result-copy h2{font-size:clamp(38px,5vw,62px);line-height:1;margin:10px 0 16px}
.result-copy p{font-size:19px;max-width:520px}
.result-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
.confetti{position:fixed;z-index:10;pointer-events:none;width:9px;height:13px;border-radius:3px;animation:confettiFall 1s ease-out forwards}
@keyframes confettiFall{from{transform:translateY(-10px) rotate(0);opacity:1}to{transform:translateY(120px) rotate(200deg);opacity:0}}
.burst{position:absolute;z-index:4;pointer-events:none;font-size:24px;animation:burst .7s ease-out forwards}
@keyframes burst{0%{opacity:1;transform:scale(.5)}100%{opacity:0;transform:translateY(-40px) scale(1.3)}}
@media(max-width:760px){
 .screen{padding:14px}
 .welcome{grid-template-columns:1fr;min-height:calc(100dvh - 28px);gap:0;align-content:center;padding-bottom:45px}
 .welcome-copy{padding:14px 5px 0}
 .welcome h1{font-size:clamp(46px,12vw,70px);margin:12px 0 15px}
 .welcome .tagline{font-size:18px;margin-bottom:18px}
 .welcome-visual{min-height:260px;grid-row:1}
 .gate-art{width:min(82%,340px);max-height:300px}
 .welcome-visual .mascot-big{width:85px;top:39%}
 .welcome-footer{bottom:8px;left:15px}
 .menu-screen{min-height:calc(100dvh - 28px);justify-content:flex-start;padding-top:10px}
 .menu-heading{margin:20px 0 12px}
 .gates{gap:5px;min-height:300px;align-items:flex-start}
 .game-gate{flex:1;padding:0 3px}
 .gate-shape{width:100%;height:clamp(190px,53vw,245px);padding:15px 7px}
 .gate-illustration{width:55px;height:55px}
 .gate-title{font-size:19px}
 .gate-desc{font-size:14px}
 .game-gate:nth-child(2){margin-top:34px}
 .pick-label{font-size:15px}
 .game-shell{min-height:calc(100dvh - 28px)}
 .game-head{align-items:flex-start}
 .game-head .left,.game-head .right{gap:6px;flex-wrap:wrap}
 .pill{font-size:13px;padding:7px 10px}
 .quiz-scene{min-height:490px;padding:15px 8px 18px;border-radius:38% 38% 16px 16px / 7% 7% 16px 16px}
 .quiz-question{width:96%;padding:15px 12px;border-radius:40% 40% 15px 15px / 14% 14% 12px 12px}
 .quiz-question h2{font-size:clamp(25px,7vw,34px)}
 .quiz-question p{font-size:17px}
 .lantern-field{height:245px;gap:0;margin-top:5px}
 .answer-lantern{width:25%;padding:0 2px}
 .answer-lantern:nth-child(1){--drop:0px}.answer-lantern:nth-child(2){--drop:25px}.answer-lantern:nth-child(3){--drop:10px}.answer-lantern:nth-child(4){--drop:38px}
 .lantern-body{width:clamp(66px,20vw,95px);height:clamp(96px,28vw,118px);font-size:16px;padding:8px 5px}
