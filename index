   showScreen('hiddenScreen');
   if(document.activeElement&&document.activeElement.blur)document.activeElement.blur();
   showQuestion();updateHiddenStats();
   window.setTimeout(()=>$('hxSwipe').classList.add('gone'),7000);
   requestAnimationFrame(()=>{
     measure();CAM.follow=true;CAM.vx=0;
     CAM.x=clampCamX(P.x*CAM.scale-CAM.vw/2);applyCam();placePipin();
     if(!raf){lastT=performance.now();raf=requestAnimationFrame(tick);}
   });
 }

 // ---- interaksi: ambil benda ----
 function interact(o){
   if(busy||hiddenLocked)return;
   pipin.classList.add('act');window.setTimeout(()=>pipin.classList.remove('act'),400);
   attempts++;
   const cur=OBJ[curId];
   if(!o){setPose('f7',1000);msg('Belum ada benda di dekat Pipin. Jalan lebih dekat ke benda yang kamu cari!');return;}
   if(found.has(o.id)){msg(`“${o.word}” sudah kamu temukan. Sekarang cari “${cur.word}”!`);return;}
   if(o.id!==curId){
     setPose('f7',1300);o.el.classList.remove('wrong');void o.el.offsetWidth;o.el.classList.add('wrong');
     msg(`Itu “${o.word}” (${o.meaning}). Yang dicari: “${cur.word}”. Ayo cari lagi!`);
     say([EN(o.word),ID('artinya '+o.meaning+'. Bukan itu. Cari'),EN(cur.word),ID('artinya '+cur.meaning)]);return;
   }
   const pts=hintUsed?5:10;
   setPose('f6',1700);found.add(o.id);hiddenScore+=pts;busy=true;o.el.classList.remove('near');o.el.classList.add('found');
   const dot=document.createElement('i');dot.className='ok';dot.style.left=(o.x/WORLD_W*100)+'%';mapEl.appendChild(dot);
   mapEl.querySelectorAll('.goal').forEach(n=>n.remove());
   msg(`Hebat! “${o.word}” artinya ${o.meaning}. +${pts} poin!`);
   say([ID('Hebat!'),EN(o.word),ID('artinya '+o.meaning)]);
   updateHiddenStats();burstAt(o.el,'✦');
   window.setTimeout(()=>{
     qi++;
     if(qi>=targets.length){hiddenLocked=true;stopSpeak();showResults('hidden');}
     else showQuestion();
   },narrate&&synth?2700:1300);
 }

 function crossesPond(ax,ay,bx,by){for(let i=0;i<=24;i++){const t=i/24;if(blocked(ax+(bx-ax)*t,ay+(by-ay)*t))return true;}return false;}
 function makeGoal(x,y,id){
   if(blocked(x,y)){y=y<POND.cy?POND.cy-POND.ry-12:clamp(POND.cy+POND.ry+12,BAND_Y0,BAND_Y1);}
   const path=[];
   if(crossesPond(P.x,P.y,x,y)){
     const topY=POND.cy-POND.ry-30,lx=POND.cx-POND.rx-40,rx=POND.cx+POND.rx+40;
     const wp=P.x<x?[[lx,topY],[rx,topY]]:[[rx,topY],[lx,topY]];
     wp.forEach(w=>path.push({x:w[0],y:w[1]}));
   }
   path.push({x,y});
   return {x,y,id,path,stuck:0};
 }
 function goTo(o){
   if(busy)return;
   if(inReach(o)){goal=null;interact(o);return;}
   const a=nearestAnchor(o);goal=makeGoal(a[0],a[1],o.id);CAM.follow=true;hideTip();
 }
 function useHint(){
   if(busy||hiddenLocked)return;const o=OBJ[curId];hintUsed=true;setPose('f8',2400);
   const a=nearestAnchor(o),dx=a[0]-P.x;
   const dir=Math.abs(dx)<140?'Sudah dekat, lihat sekelilingmu!':dx<0?'Ada di sebelah kiri ◀':'Ada di sebelah kanan ▶';
   msg(`💡 “${o.word}” = ${o.meaning}. ${o.clue} ${dir}`);
   say([EN(o.word),ID('artinya '+o.meaning+'. '+o.clue)]);
   $('hxQ').textContent=`Soal ${qi+1} dari ${targets.length} · poin 5`;
   mapEl.querySelectorAll('.goal').forEach(n=>n.remove());
   const g=document.createElement('i');g.className='goal';g.style.left=(o.x/WORLD_W*100)+'%';mapEl.appendChild(g);
 }
 let narrate=true;
 const synth=window.speechSynthesis||null;
 const EN=t=>({t,lang:'en-US'}), ID=t=>({t,lang:'id-ID'});
 function stopSpeak(){try{if(typeof speakTok!=='undefined')speakTok++;if(synth)synth.cancel();if(typeof killAudio==='function')killAudio();}catch(e){}}
 let voices=[],speakTok=0;
 function loadVoices(){try{voices=synth?synth.getVoices():[];}catch(e){}}
 if(synth){loadVoices();try{synth.addEventListener('voiceschanged',loadVoices);}catch(e){synth.onvoiceschanged=loadVoices;}}
 function pickVoice(lang){
   const l=lang.toLowerCase(),pre=l.slice(0,2);
   return voices.find(v=>v.lang&&v.lang.toLowerCase().replace('_','-')===l)||voices.find(v=>v.lang&&v.lang.toLowerCase().startsWith(pre))||null;
 }
 let curAudio=null;
 function killAudio(){try{if(curAudio){curAudio.onended=curAudio.onerror=null;curAudio.pause();curAudio=null;}}catch(e){}}
 function say(parts,force){
   if(!(narrate||force))return;
   const tok=++speakTok;
   try{if(synth){synth.cancel();synth.resume&&synth.resume();}}catch(e){}
   killAudio();
   const queue=parts.slice();
   function playPart(p,cb){
     let finished=false,started=false,fb=false,t1=0,t2=0;
     const finish=()=>{if(finished)return;finished=true;clearTimeout(t1);clearTimeout(t2);cb();};
     const fallback=()=>{
       if(finished||fb)return;fb=true;clearTimeout(t1);
       try{if(synth)synth.cancel();}catch(e){}
       try{
         const a=new Audio('https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl='+(p.lang==='en-US'?'en':'id')+'&q='+encodeURIComponent(p.t));
         curAudio=a;a.onended=finish;a.onerror=finish;
         const pr=a.play();if(pr&&pr.catch)pr.catch(finish);
       }catch(e){finish();}
     };
     t2=setTimeout(finish,Math.max(4500,p.t.length*260));
     if(!synth||!window.SpeechSynthesisUtterance){fallback();return;}
     try{
       const u=new SpeechSynthesisUtterance(p.t);
       u.lang=p.lang;const v=pickVoice(p.lang);if(v)u.voice=v;
       u.rate=p.lang==='en-US'?.8:.95;u.pitch=1.1;
       u.onstart=()=>{started=true;clearTimeout(t1);};
       u.onend=()=>{if(!fb)finish();};
       u.onerror=()=>{if(!fb){if(started)finish();else fallback();}};
       t1=setTimeout(()=>{if(!started)fallback();},1500);
       synth.speak(u);
     }catch(e){fallback();}
   }
   function next(){
     if(tok!==speakTok||!queue.length)return;
     playPart(queue.shift(),()=>{if(tok===speakTok)next();});
   }
   window.setTimeout(()=>{if(tok===speakTok)next();},120);
 }
 $('hxHint').addEventListener('click',useHint);
 $('hxSpeak').addEventListener('click',()=>say([ID('Cari'),EN(OBJ[curId].word),ID('artinya '+OBJ[curId].meaning)],true));
 $('hxMute').addEventListener('click',()=>{
   narrate=!narrate;const b=$('hxMute');b.textContent=narrate?'🔊':'🔇';
   b.setAttribute('aria-pressed',String(narrate));b.setAttribute('aria-label',narrate?'Narasi suara menyala':'Narasi suara mati');
   if(!narrate)stopSpeak();else say([ID('Cari'),EN(OBJ[curId].word),ID('artinya '+OBJ[curId].meaning)]);
 });
 $('hiddenChange').addEventListener('click',stopSpeak);
 $('hxAct').addEventListener('click',()=>{interact(nearestObj());$('hxAct').blur();});

 // ---- loop utama: gerak Pipin + kamera ----
 function tick(t){
   raf=0;
   if($('hiddenScreen').hidden)return;
   const dt=Math.min(.05,Math.max(.001,(t-lastT)/1000));lastT=t;
   let ix=0,iy=0;
   if(keys.has('L')||pad.has('L'))ix-=1;if(keys.has('R')||pad.has('R'))ix+=1;
   if(keys.has('U')||pad.has('U'))iy-=1;if(keys.has('D')||pad.has('D'))iy+=1;
   let mx=0,my=0;
   if(ix||iy){goal=null;const l=Math.hypot(ix,iy);mx=ix/l;my=iy/l;hideTip();}
   else if(goal){
     const o=goal.id?OBJ[goal.id]:null;
     if(o&&inReach(o)){goal=null;interact(o);}
     else{
       const tg=goal.path[0],dx=tg.x-P.x,dy=tg.y-P.y,d=Math.hypot(dx,dy);
       if(d<8){goal.path.shift();if(!goal.path.length)goal=null;}else{mx=dx/d;my=dy/d;}
     }
   }
   let moved=false;
   if(mx||my){
     const sp=SPEED*dt;
     const nx=clamp(P.x+mx*sp,X0,X1),ny=clamp(P.y+my*sp,BAND_Y0,BAND_Y1);
     if(!blocked(nx,ny)){P.x=nx;P.y=ny;moved=true;}
     else if(!blocked(nx,P.y)){P.x=nx;moved=true;}
     else if(!blocked(P.x,ny)){P.y=ny;moved=true;}
     if(mx>.1)P.dir=1;else if(mx<-.1)P.dir=-1;
     if(goal){if(moved)goal.stuck=0;else{goal.stuck=(goal.stuck||0)+dt;if(goal.stuck>.5)goal=null;}}
     CAM.follow=true;
   }
   pipin.classList.toggle('walking',moved);
   {
     let f;
     if(performance.now()<poseUntil)f=pose;
     else if(moved){frameT+=dt;if(frameT>.12){frameT=0;frameI=(frameI+1)%WALK.length;}f=WALK[frameI];}
     else{frameT=0;f=nearId?'f9':'f1';}
     setFrame(f);
   }
   // kamera
   if(!drag){
     if(CAM.follow){const target=clampCamX(P.x*CAM.scale-CAM.vw/2);CAM.x+=(target-CAM.x)*Math.min(1,dt*5);CAM.vx=0;}
     else if(CAM.vx){CAM.x+=CAM.vx*dt;CAM.vx*=Math.exp(-5*dt);if(Math.abs(CAM.vx)<8)CAM.vx=0;const c=clampCamX(CAM.x);if(c!==CAM.x){CAM.x=c;CAM.vx=0;}}
   }
   applyCam();placePipin();
   // benda terdekat
   const n=nearestObj(),id=n&&!busy?n.id:'';
   if(id!==nearId){
     if(nearId&&OBJ[nearId])OBJ[nearId].el.classList.remove('near');
     if(id&&!found.has(id))OBJ[id].el.classList.add('near');
     nearId=id;
   }
   pipin.classList.toggle('near',!!id);$('hxAct').classList.toggle('ready',!!id);
   raf=requestAnimationFrame(tick);
 }

 // ---- geser dunia dengan jari/mouse ----
 let drag=null;
 vp.addEventListener('pointerdown',e=>{
   if(e.pointerType==='mouse'&&e.button!==0)return;
   drag={id:e.pointerId,sx:e.clientX,cx:CAM.x,last:e.clientX,lt:performance.now(),moved:false,vx:0};
 });
 window.addEventListener('pointermove',e=>{
   if(!drag||e.pointerId!==drag.id)return;
   const dx=e.clientX-drag.sx;
   if(!drag.moved&&Math.abs(dx)>6){drag.moved=true;vp.classList.add('dragging');CAM.follow=false;CAM.vx=0;hideTip();}
   if(drag.moved){
     CAM.x=clampCamX(drag.cx-dx);
     const now=performance.now(),dtm=now-drag.lt;
     if(dtm>0)drag.vx=((drag.last-e.clientX)/dtm*1000)*.6+drag.vx*.4;
     drag.last=e.clientX;drag.lt=now;applyCam();
   }
 });
 function endDrag(e){
   if(!drag||e.pointerId!==drag.id)return;
   if(drag.moved){CAM.vx=Math.abs(drag.vx)>60?clamp(drag.vx,-2600,2600):0;dragMoved=true;window.setTimeout(()=>{dragMoved=false;},60);}
   vp.classList.remove('dragging');drag=null;
 }
 window.addEventListener('pointerup',endDrag);window.addEventListener('pointercancel',endDrag);
 vp.addEventListener('click',e=>{
   if(dragMoved||hiddenLocked)return;
   const spot=e.target.closest&&e.target.closest('.hx-spot');
   if(spot){spot.blur();goTo(OBJ[spot.dataset.id]);return;}
   const r=vp.getBoundingClientRect();
   const wx=(e.clientX-r.left+CAM.x)/CAM.scale,wy=(e.clientY-r.top-(CAM.y||0))/CAM.scale;
   goal=makeGoal(clamp(wx,X0,X1),clamp(wy,BAND_Y0,BAND_Y1),null);CAM.follow=true;hideTip();
   const m=document.createElement('i');m.className='hx-tap';m.style.left=goal.x+'px';m.style.top=goal.y+'px';
   world.appendChild(m);window.setTimeout(()=>m.remove(),750);
 });

 // ---- minimap: ketuk / seret untuk loncat ke bagian taman ----
 let mapDrag=false;
 function mapTo(e){
   const r=mapEl.getBoundingClientRect(),f=clamp((e.clientX-r.left)/r.width,0,1);
   CAM.follow=false;CAM.vx=0;CAM.x=clampCamX(f*WORLD_W*CAM.scale-CAM.vw/2);applyCam();hideTip();
 }
 mapEl.addEventListener('pointerdown',e=>{mapDrag=true;try{mapEl.setPointerCapture(e.pointerId);}catch(_){}mapTo(e);});
 mapEl.addEventListener('pointermove',e=>{if(mapDrag)mapTo(e);});
 mapEl.addEventListener('pointerup',()=>{mapDrag=false;});mapEl.addEventListener('pointercancel',()=>{mapDrag=false;});

 // ---- D-pad layar sentuh ----
 document.querySelectorAll('#hxDpad button').forEach(b=>{
   const k=b.dataset.k;
   b.addEventListener('pointerdown',e=>{e.preventDefault();try{b.setPointerCapture(e.pointerId);}catch(_){}pad.add(k);b.classList.add('on');});
   const up=()=>{pad.delete(k);b.classList.remove('on');};
   b.addEventListener('pointerup',up);b.addEventListener('pointercancel',up);b.addEventListener('lostpointercapture',up);
   b.addEventListener('contextmenu',e=>e.preventDefault());
 });

 // ---- keyboard ----
 const KEYMAP={ArrowLeft:'L',a:'L',A:'L',ArrowRight:'R',d:'R',D:'R',ArrowUp:'U',w:'U',W:'U',ArrowDown:'D',s:'D',S:'D'};
 document.addEventListener('keydown',e=>{
   if(activeMode!=='hidden'||$('hiddenScreen').hidden)return;
   if(e.metaKey||e.ctrlKey||e.altKey)return;
   const k=KEYMAP[e.key];
   if(k){keys.add(k);e.preventDefault();return;}
   if(e.key===' '||e.key==='Enter'||e.key==='e'||e.key==='E'){
     const t=e.target;
     if(t&&t.tagName==='BUTTON'&&!t.classList.contains('hx-spot'))return;
     e.preventDefault();if(!e.repeat)interact(nearestObj());
   }
 });
 document.addEventListener('keyup',e=>{const k=KEYMAP[e.key];if(k)keys.delete(k);});
 window.addEventListener('blur',()=>{keys.clear();pad.clear();});
 if(window.ResizeObserver)new ResizeObserver(()=>{if(!$('hiddenScreen').hidden)measure();}).observe(vp);
 window.addEventListener('resize',()=>{if(!$('hiddenScreen').hidden)measure();});

 function showResults(mode){
   activeMode=mode;showScreen('resultScreen');
   const score=mode==='quiz'?quizScore:hiddenScore;
   const total=mode==='quiz'?questions.length*10:targets.length*10;
   const ratio=score/total;
   const stars=ratio>=.85?3:ratio>=.5?2:1;
   $('resultScore').textContent=score;
   $('resultModeLabel').textContent=mode==='quiz'?'KUIS LAMPION':'PEMBURU BENDA';
   $('resultAccuracy').textContent=mode==='quiz'?`${quizCorrect} dari ${questions.length} jawaban tepat`:`${found.size} dari ${targets.length} benda ditemukan`;
   $('resultTitle').textContent=stars===3?'Wah, hebat sekali!':stars===2?'Petualang hebat!':'Terus berlatih, ya!';
   $('resultMessage').textContent=mode==='quiz'
     ? (stars===3?'Kamu makin kenal kata bahasa Inggris dan artinya. Sekarang kamu lebih siap menemukan kata-kata itu saat membaca atau bermain!': 'Kamu sudah belajar kata baru hari ini. Ulangi lagi untuk mengingat arti kata dan makin percaya diri mengucapkannya!')
     : 'Kamu berhasil menjelajahi taman dan menemukan benda dalam bahasa Inggris. Sekarang kamu lebih siap mengenali kata-kata itu di dunia nyata!';
   $('resultDetail').textContent=mode==='quiz'
     ? 'Setiap jawaban adalah langkah kecil menuju kosakata yang lebih banyak.'
     : `Kamu mencoba mengambil benda ${attempts} kali bersama Pipin. Setiap benda punya nama bahasa Inggris!`;
   for(let i=1;i<=3;i++){
     const el=$('star'+i);el.classList.remove('lit');
     if(i<=stars)setTimeout(()=>el.classList.add('lit'),i*260);
   }
   confetti();
 }
 $('quizChange').addEventListener('click',()=>showScreen('menuScreen'));
 $('hiddenChange').addEventListener('click',()=>showScreen('menuScreen'));
 $('playAgain').addEventListener('click',()=>activeMode==='quiz'?startQuiz():startHidden());
 $('chooseAgain').addEventListener('click',()=>showScreen('menuScreen'));
})();
